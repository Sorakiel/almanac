{
  "title": "Almanac — usage",
  "uid": "almanac-usage",
  "tags": ["almanac"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1h",
  "time": { "from": "now-90d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Database",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Module adoption",
      "description": "Rows, distinct users who ever used it, and the last time anything happened. The audit's \"breadth outran depth\", as a query.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select module, rows_total, users_ever, last_activity from analytics.module_adoption order by users_ever desc, rows_total desc"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "users_ever" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "orange", "value": 1 },
                    { "color": "green", "value": 3 }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active users · last 7 days",
      "description": "Distinct people who closed at least one habit.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select max(active_users) as \"active\" from analytics.daily_activity where day > current_date - 7"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total users",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(max(total_users), 0) as \"users\" from analytics.user_growth"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Habit completions per day",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select day as time, habit_completions, active_users from analytics.daily_activity order by day"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 12, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Other modules per day",
      "description": "Workouts, reading sessions, reflections, focus blocks. Flat lines here are the whole point of the dashboard.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select day as time, workouts_completed, reading_sessions, reflections_written, focus_sessions from analytics.daily_activity order by day"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 8, "lineWidth": 2 } },
        "overrides": []
      }
    }
  ]
}
